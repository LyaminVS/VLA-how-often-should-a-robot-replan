# Publish the completed study; keep temporary runs and review sheets local.
!outputs/compact/
!outputs/validation/
!outputs/expanded/
!outputs/validation-plan.json
outputs/*/*
!outputs/*/manifest.json
!outputs/*/annotations.csv
!outputs/*/inspection.json
!outputs/*/discussion.json
!outputs/*/review-*.json
!outputs/*/protocol-record.json
!outputs/*/episodes/
!outputs/*/report/
!outputs/*/demo.mp4
!outputs/*/demo.json
outputs/*/episodes/*/*
!outputs/*/episodes/*/summary.json
!outputs/*/episodes/*/steps.jsonl
!outputs/*/episodes/*/chunks.jsonl
!outputs/*/episodes/*/video.mp4
!outputs/compact/demos/
!outputs/compact/demos/*.mp4
!output/pdf/

# Moving-target robustness experiment and its reproducible presentation.
!outputs/moving-target/
!outputs/moving-target/manifest.json
!outputs/moving-target/episodes/
!outputs/moving-target/episodes/*/evidence.json
!outputs/moving-target-report/
!outputs/moving-target-report/**
!outputs/moving-calibration/
!outputs/moving-calibration/**
outputs/**/.run.lock
outputs/**/attempts/

# Adaptive replanning comparison and independently replayable FM diagnostics.
!outputs/dvac/
!outputs/dvac/invariance.json
!outputs/dvac-report/
!outputs/dvac-report/**
!outputs/dvac-check/
!outputs/dvac-check/**
!outputs/dvac-plan.json

# Capped adaptive comparison, reusing the matched fixed-interval evidence.
!outputs/capped/
!outputs/capped/invariance.json
!outputs/capped/reference-audit.json
!outputs/capped-report/
!outputs/capped-report/**
!outputs/capped-check/
!outputs/capped-check/**
!outputs/capped-plan.json

# One standalone demonstration linked from the README.
!outputs/demo/
